    [space](* <- lang_en;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (космос)](* <- lang_ru;;*);
            [Def. (space)](* <- lang_ru;;*);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Космос - относительно пустые участки Вселенной, которые лежат вне границ атмосфер небесных тел.]
                    (* <- lang_ru;; *);;
            *);...
            (*
