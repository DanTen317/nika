  [Yerkes spectral classification](* <- lang_en;; *);
  [Morgan-Keenan system](* <- lang_en;; *);
<- rrel_key_sc_element:
  ...
  (*
    => nrel_main_idtf:
    [Опр. (класс светимости)](* <- lang_ru;; *);
    [Def. (luminosity class)](* <- lang_en;; *);;
    <- definition;;
    <= nrel_sc_text_translation:
      ...
      (*
        -> rrel_example:
           [Класс светимости - класс звёзды в зависимости от ее светимости (или абсолютной звёздной величины)]
           (* <- lang_ru;; *);;
      *);
      ...
      (*
