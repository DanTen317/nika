concept_cosmic_dust
<- sc_node_class;
=> nrel_main_idtf:
    [космическая пыль](* <- lang_ru;; *);
    [cosmic dust](* <- lang_en;; *);
=> nrel_idtf:
    [space dust](* <- lang_en;; *);
    [star dust](* <- lang_en;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (космическая пыль)](* <- lang_ru;; *);
            [Def. (cosmic dust)](* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Космическая пыль — наименьшие частицы космических объектов, находящиеся в космосе или упавшие на Землю.]
                    (* <- lang_ru;; *);;
            *);...
            (*
                -> rrel_example:
                    [Cosmic dust is a smallest particles of celestial objects that occurs in outer space or has fallen onto Earth.]
                    (* <- lang_en;; *);;
            *);;
        => nrel_using_constants:
        {
        concept_cosmic_dust;
        concept_celestial_object;
        concept_space
        };;
    *);;