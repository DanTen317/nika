concept_exoplanet
<- sc_node_class;
=> nrel_main_idtf:
    [экзопланета](* <- lang_ru;; *);
    [exoplanet](* <- lang_en;; *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (экзопланета)](* <- lang_ru;; *);
            [Def. (exoplanet)](* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Экзопланета - планета вне солнечной системы.]
                    (* <- lang_ru;; *);;
            *);...
            (*
                -> rrel_example:
                    [An exoplanet is a planet outside of the Solar System.]
                    (* <- lang_en;; *);;
            *);;
        => nrel_using_constants:
        {
        concept_exoplanet;
        concept_planet
        };;
    *);
=> nrel_note: ...
(*
    <= nrel_sc_text_translation: ...
    (*
        -> [Долгое время задача обнаружения планет возле других звёзд оставалась неразрешённой, так как планеты чрезвычайно малы и тусклы по сравнению со звёздами, а сами звёзды находятся далеко от Солнца. Сейчас такие планеты стали открывать благодаря усовершенствованным научным методам.](* <- lang_ru;; *);;
    *);...
    (*
        -> [Большинство известных экзопланет — газовые гиганты и более походят на Юпитер, чем на Землю. Это объясняется ограниченностью современных методов обнаружения.](* <- lang_ru;; *);;
    *);;
*);;