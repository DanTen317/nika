concept_universe
<- sc_node_class;
=> nrel_main_idtf:
  [вселенная](* <- lang_ru;; *);
  [universe](* <- lang_en;; *);
<- rrel_key_sc_element:
  ...
  (*
    => nrel_main_idtf:
            [Опр. (Вселенная)](* <- lang_ru;; *);
            [Def. (Universe)](* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Вселенная - не имеющее строгого определения понятие в астрономии и философии, под которым чаще всего подразумевается совокупность всей существующей в мире энергии, материи и пространства-времени.](* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [The universe is all of space and time and their contents.](* <- lang_en;; *);;
            *);;
  *);;